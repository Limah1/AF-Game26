                "opcao1": {
                    "botao": "Quero perguntar outra coisa"
                }
            },
            "opcao2": {
                "botao": "Não",
                "resposta": "Tudo bem, mas lembre-se que sempre dá para se divertir de formas diferentes.",
                "voice": "res://assets/hospital/psicologo/audio/opcao1_opcao1_opcao2.ogg",
                "opcao1": {
                    "botao": "Quero perguntar outra coisa"
                }
            }
        },
        "opcao2": {
            "botao": "Tenho medo das crises",
            "resposta": "O medo é normal, mas vamos pensar no que você pode fazer para se sentir mais seguro.",
            "voice": "res://assets/hospital/psicologo/audio/opcao1_opcao2.ogg",
            "opcao1": {
                "botao": "Chamar um adulto",
                "resposta": "Isso mesmo! Além disso, beber água e descansar ajudam muito.",
                "voice": "res://assets/hospital/psicologo/audio/opcao1_opcao2_opcao1.ogg",
                "opcao1": {
                    "botao": "Quero perguntar outra coisa"
                }
            },
            "opcao2": {
                "botao": "Tomar o remédio",
                "resposta": "Correto! O remédio foi receitado para te proteger e deve ser tomado nos horários certos.",
                "voice": "res://assets/hospital/psicologo/audio/opcao1_opcao2_opcao2.ogg",
                "opcao1": {
                    "botao": "Quero perguntar outra coisa"
                }
            }
        }
    },
    "opcao2": {
        "botao": "Estou feliz hoje",
        "resposta": "Fico muito feliz! O que deixou o seu dia bom?",
        "voice": "res://assets/hospital/psicologo/audio/opcao2.ogg",
