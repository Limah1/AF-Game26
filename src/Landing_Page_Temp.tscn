[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

uniform float scroll_speed_x = 0.03;
uniform float scroll_speed_y = 0.03;

void fragment() {
    vec2 uv = UV;
    uv.x += TIME * scroll_speed_x;
    uv.y += TIME * scroll_speed_y;
    COLOR = texture(TEXTURE, uv);
}"

