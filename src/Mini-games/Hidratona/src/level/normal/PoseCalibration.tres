[gd_resource type="Resource" load_steps=2 format=2]

[sub_resource type="GDScript" id=1]
script/source = "extends Resource

const BASE_HEAD_POSITIONS = [Vector2(-1, -5), Vector2(-13, -5), Vector2(-2.5, -5), Vector2(7, -1), Vector2(1.5, -3.5), Vector2(-7, -4.5), Vector2(0.5, -0.5)]

export(Array, Vector2) var head_offsets = [Vector2(9, 0), Vector2(9, 0), Vector2(9, 0), Vector2(9, 0), Vector2(9, 0), Vector2(9, 0), Vector2(9, 0)]
export(float) var body_scale = 1.3
export(float) var head_scale = 0.15
export(Vector2) var neck_offset = Vector2(-10, 25)
export(Vector2) var neck_size = Vector2(20, 20)
export(Array, Vector2) var pose_head_positions = [Vector2(-4, -5.5), Vector2(3, -7), Vector2(-45.5, 31.5)]
export(Array, float) var pose_body_scales = [1.0, 1.0, 1.0]
export(Array, float) var pose_head_scales = [0.105, 0.105, 0.105]
export(Array, Vector2) var pose_neck_offsets = [Vector2(-10, 25), Vector2(-10, 25), Vector2(-10, 25)]
export(Array, Vector2) var pose_neck_sizes = [Vector2(20, 20), Vector2(20, 20), Vector2(20, 20)]

func get_head_position(frame: int) -> Vector2:
	return BASE_HEAD_POSITIONS[frame - 1] + head_offsets[frame - 1]
"

[resource]
script = SubResource( 1 )
head_offsets = [ Vector2( 9, 0 ), Vector2( 9, 0 ), Vector2( 9, 0 ), Vector2( 9, 0 ), Vector2( 9, 0 ), Vector2( 9, 0 ), Vector2( 9, 0 ) ]
body_scale = 1.3
head_scale = 0.167
neck_offset = Vector2( -10, 25 )
neck_size = Vector2( 20, 20 )
pose_head_positions = [ Vector2( 5, -6 ), Vector2( 3, -7 ), Vector2( -26, 32 ) ]
pose_body_scales = [ 1.0, 1.0, 1.0 ]
pose_head_scales = [ 0.167, 0.167, 0.167 ]
pose_neck_offsets = [ Vector2( -10, 25 ), Vector2( -10, 25 ), Vector2( -10, 25 ) ]
pose_neck_sizes = [ Vector2( 20, 20 ), Vector2( 20, 20 ), Vector2( 20, 20 ) ]
