bbcode_enabled = true
bbcode_text = "Hora de ir mais devagar. Sente-se ou deite um pouco, tome goles de água e faça respirações calmas (puxa pelo nariz contando 3, solta pela boca contando 3). Se estiver frio, fique quentinho. Uma compressa morna pode ajudar. Faça coisas tranquilas, como desenhar ou ouvir música, e veja se melhora."
text = "Hora de ir mais devagar. Sente-se ou deite um pouco, tome goles de água e faça respirações calmas (puxa pelo nariz contando 3, solta pela boca contando 3). Se estiver frio, fique quentinho. Uma compressa morna pode ajudar. Faça coisas tranquilas, como desenhar ou ouvir música, e veja se melhora."

